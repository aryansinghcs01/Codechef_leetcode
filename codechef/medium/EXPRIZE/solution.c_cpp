
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        long long N;
        cin >> N;

        long long low = 1, high = 2000000, ans = 1;

        while (low <= high) {
            long long mid = low + (high - low) / 2;
            long long sum = mid * (mid * mid + 5) / 6;

            if (sum <= N) {
                ans = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}

