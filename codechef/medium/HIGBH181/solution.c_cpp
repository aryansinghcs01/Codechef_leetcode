#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    int adj[100][100] = {0};

    for (int i = 0; i < N - 1; i++) {
        int u, v;
        scanf("%d %d", &u, &v);

        adj[u][v] = 1;
        adj[v][u] = 1;
    }

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            printf("%d", adj[i][j]);

            if (j < N - 1)
                printf(" ");
        }
        printf("\n");
    }

    return 0;
}